# AWS S3 Configuration for Image Gallery
# Copy this file to .env.local for local development
# For production deployment, set these as environment variables on your platform

# AWS Access Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# AWS S3 Configuration  
AWS_REGION=eu-north-1
AWS_S3_BUCKET=snapsplit-rapida-solutions

# Gallery Authentication (Optional - if not set, uses hardcoded values)
# GALLERY_USERNAME=your_username_here
# GALLERY_PASSWORD=your_password_here

# Additional environment variables can be added here
# NEXT_PUBLIC_* variables are exposed to the client-side
# Regular variables are server-side only (recommended for AWS credentials and auth)

# Firebase Web Config for real-time collaborative sessions (/s/[id])
# Register a Web App in the Firebase console (project: snapsplit-81eb2) and copy
# its config here. These NEXT_PUBLIC_* values are safe to expose to the browser.
# Also enable the Anonymous sign-in provider in Firebase Authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=snapsplit-81eb2.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=snapsplit-81eb2
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=snapsplit-81eb2.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=17097832458
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id_here